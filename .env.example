BACKEND_URL=https://natura-api.onrender.com

# Email de contacto (destinatario de los mensajes del formulario)
CONTACT_EMAIL=terear@hotmail.es

# SMTP para envío de emails del formulario de contacto
# Ejemplo con Gmail (requiere contraseña de aplicación, no la cuenta normal):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion

# Ejemplo con Hotmail/Outlook:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=terear@hotmail.es
# SMTP_PASS=tu-contrasena
