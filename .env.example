# ============================================================
#  Natura · variables de entorno
# ============================================================
#  Copiar a `.env.local` en desarrollo y configurar los mismos
#  valores en Vercel para producción.
# ============================================================

# ─── Backend (FastAPI en Render) ────────────────────────────
# URL pública del backend consumido desde el navegador
NEXT_PUBLIC_BACKEND_URL=https://natura-api.onrender.com
# URL usada por las rutas API server-side (puede ser interna)
BACKEND_URL=https://natura-api.onrender.com
# Secreto compartido con el backend para endpoints /api/admin
BBDD_SECRET=cambia-esto-por-el-mismo-valor-que-en-el-backend

# ─── Panel /admin ───────────────────────────────────────────
# Contraseña de acceso al panel (¡fuerte!)
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-fuerte
# Secreto HMAC para firmar la cookie de sesión (mínimo 32 chars aleatorios)
# Genera uno con: openssl rand -hex 32
ADMIN_SESSION_SECRET=cambia-esto-por-un-secret-largo-y-aleatorio

# ─── Email del formulario de contacto ───────────────────────
CONTACT_EMAIL=terear@hotmail.es

# SMTP para envío del formulario
# Gmail: contraseña de aplicación (no la de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion

# Alternativa Hotmail/Outlook:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=terear@hotmail.es
# SMTP_PASS=tu-contrasena
